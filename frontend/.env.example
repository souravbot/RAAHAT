# RAAHAT frontend environment
# Copy to .env and adjust as needed.

# Base URL for API calls.
# When using Vite dev proxy, leave empty so requests like /twin, /priority, /demo etc. are proxied directly to FastAPI backend.
# If connecting directly to a remote or standalone backend without proxy, set e.g.: http://localhost:8000
VITE_API_BASE_URL=

# Vite dev server port
VITE_PORT=5173
